#!/bin/sh

uci -q batch <<-EOF
	delete network.wan6
	delete network.globals.ula_prefix
	set network.lan.ipv6='0'
	set network.wan.ipv6='0'
	commit network

	set dhcp.lan.dhcpv6='disabled'
	set dhcp.lan.ra='disabled'
	set dhcp.lan.ndp='disabled'
	set dhcp.@dnsmasq[0].filter_aaaa='1'
	set dhcp.@dnsmasq[0].cachesize='8000'
	set dhcp.@dnsmasq[0].ednspacket_max='1232'
	commit dhcp

	del_list uhttpd.main.listen_http='[::]:80'
	del_list uhttpd.main.listen_https='[::]:443'
	commit uhttpd

	set firewall.@defaults[0].flow_offloading='1'
	set firewall.@defaults[0].flow_offloading_hw='1'
	set firewall.@defaults[0].fullcone='1'
	set firewall.@defaults[0].fullcone6='0'
	commit firewall
EOF

if ! uci -q get firewall.block_quic >/dev/null; then
	uci -q batch <<-EOF
		set firewall.block_quic=rule
		set firewall.block_quic.name='Block-QUIC-UDP443'
		set firewall.block_quic.src='lan'
		set firewall.block_quic.dest='wan'
		set firewall.block_quic.proto='udp'
		set firewall.block_quic.dest_port='443'
		set firewall.block_quic.target='REJECT'
		set firewall.block_quic.enabled='0'
		commit firewall
	EOF
fi

exit 0

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-cp-02=y

# 核心转发、硬件流表卸载、FullCone NAT、BBR
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 无线认证组件（单路由主路由模式：保留完整 wpad-openssl，移除多余 dawn / umdns）
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_dawn=n
CONFIG_PACKAGE_luci-app-dawn=n
CONFIG_PACKAGE_umdns=n

# 精简 IPv6 服务组件（内核协议栈保留兼容，由 sysctl 与 uci 彻底关闭）
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_odhcp6c=n

# 轻量 UPnP 映射支持（默认关闭，辅助手机端 VPN / 游戏穿透）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# 精简多余存储自动挂载及科学/去广告/流控插件（纯净直通）
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-adbyby-plus=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-sqm=n
